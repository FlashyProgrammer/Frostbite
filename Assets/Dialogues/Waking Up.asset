    lineStayTime: 3
  - charName: ???
    line: 'Hello, 404.  '
    lineStayTime: 3
  - charName: 404
    line: 'How do you know my name? '
    lineStayTime: 3
  - charName: ???
    line: "We have a list of missing children. \n"
