  m_Script: {fileID: 11500000, guid: 4d65a25843a2ebe4aa7d8116cd0ce451, type: 3}
  m_Name: Waking Up
  m_EditorClassIdentifier: Assembly-CSharp::Character
  charLines:
  - charName: 404
    line: 'Huh? '
    lineStayTime: 3
    clip: {fileID: 0}
  - charName: 404
    line: "It\u2019s cold in here\u2026 "
    lineStayTime: 8
    clip: {fileID: 0}
  - charName: 404
    line: 'Hello? '
    lineStayTime: 3
    clip: {fileID: 0}
  - charName: 
    line: '[Intercom Static]'
    lineStayTime: 3
    clip: {fileID: 0}
  - charName: ???
    line: 'Hello, 404.  '
    lineStayTime: 3
    clip: {fileID: 8300000, guid: aff77c1754cb0f046808b4f437b6d2fe, type: 3}
  - charName: 404
    line: 'How do you know my name? '
    lineStayTime: 3
    clip: {fileID: 0}
  - charName: ???
    line: "We have a list of missing children. \n"
    lineStayTime: 3
    clip: {fileID: 8300000, guid: 94ae937d1427a4441b89f4f28014df93, type: 3}
  - charName: 404
    line: Oh...
    lineStayTime: 3
    clip: {fileID: 0}
  - charName: 404
    line: Where am I?
    lineStayTime: 3
    clip: {fileID: 0}
  - charName: ???
    line: 'You seem to be in an old facility. Help is on its way. '
    lineStayTime: 3
    clip: {fileID: 8300000, guid: d1ee3bd77119e05478c6511df910a949, type: 3}
  - charName: 404
    line: Oh, okay!
    lineStayTime: 3
    clip: {fileID: 0}
  - charName: 404
    line: Thank you...
    lineStayTime: 3
    clip: {fileID: 0}
  - charName: ???
    line: "You can look around in the meantime. Just don\u2019t go outside.  "
    lineStayTime: 3
    clip: {fileID: 8300000, guid: 7bd558915e645774cb4e590505422c17, type: 3}
  - charName: ???
    line: "There\u2019s a very bad snowstorm. We won\u2019t be able to find you if
      you leave. "
    lineStayTime: 2
    clip: {fileID: 8300000, guid: c86d9cffabf7c0d4f85c81b26c382f0e, type: 3}
  - charName: 404
    line: "Oh, that\u2019s why it\u2019s so cold."
    lineStayTime: 3
    clip: {fileID: 0}
  - charName: ???
    line: You should look around before you sleep.
    lineStayTime: 4
    clip: {fileID: 8300000, guid: a7213c18201454f4c9cb2509cc582442, type: 3}
  - charName: ???
    line: Things get difficult at night...
    lineStayTime: 4
    clip: {fileID: 8300000, guid: 2ece009a053a1e84787b396d9df2e416, type: 3}
